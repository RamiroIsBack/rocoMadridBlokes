# React SPA served via index.php
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /blokes-dev/

  # Static assets (JS, CSS, fonts…): serve directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # All other routes (SPA subroutes): hand off to index.php
  RewriteRule ^ index.php [L]
</IfModule>

# Aggressive cache for hashed assets (JS, CSS, fonts, images)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                "access plus 0 seconds"
  ExpiresByType application/javascript   "access plus 1 year"
  ExpiresByType text/css                 "access plus 1 year"
  ExpiresByType image/webp               "access plus 1 year"
  ExpiresByType image/png                "access plus 1 year"
  ExpiresByType image/jpeg               "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 year"
  ExpiresByType font/woff2               "access plus 1 year"
</IfModule>

# App instalable (PWA): el manifest con su tipo, y el service worker siempre fresco
# (si se cachease un año como el resto de .js, los móviles no verían sus cambios)
AddType application/manifest+json .webmanifest
<FilesMatch "^(sw\.js|manifest\.webmanifest)$">
  <IfModule mod_expires.c>
    ExpiresActive Off
  </IfModule>
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache"
  </IfModule>
</FilesMatch>

# Security: block access to hidden files
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>
